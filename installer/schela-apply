# --- cron ------------------------------------------------------------------
# /etc/cron.d comes with the cron package. Without it the files are still
# written (so jobs start once cron is installed) but nothing runs them.
ensure_cron_dir() {
  install -d -m 0755 /etc/cron.d
  if ! command -v cron >/dev/null 2>&1 && ! command -v crond >/dev/null 2>&1; then
    log "cron is not installed: cron jobs and scheduled backups will not run (apt-get install cron)"
  fi
}

apply_cron() {
  [ "$DRY" -eq 1 ] && { log "would apply cron jobs"; return; }
  ensure_cron_dir
  dest=/etc/cron.d/schela-jobs
  {
    echo "SHELL=/bin/sh"
    echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    echo "MAILTO="
    while IFS= read -r job; do
      [ -n "$job" ] || continue
      enabled="$(jq -r '.enabled' <<<"$job")"
      [ "$enabled" = "true" ] || [ "$enabled" = "t" ] || [ "$enabled" = "1" ] || continue
      user="$(jq -r '.user' <<<"$job")"
      sched="$(jq -r '.schedule' <<<"$job")"
      cmd="$(jq -r '.command' <<<"$job")"
      cwd="$(jq -r '.cwd // empty' <<<"$job")"
      ok_user "$user" || continue
      [[ "$sched" =~ ^[0-9*/,[:space:]-]+$ ]] || continue
      [[ "$cmd" != *$'\n'* ]] || continue
      [[ "$cmd" != *%* ]] || continue
      if [ -n "$cwd" ] && [[ "$cwd" =~ ^/home/[a-z_][a-z0-9_-]{0,31}/(www|app)$ ]]; then
        printf '%s %s cd %s && %s\n' "$sched" "$user" "$cwd" "$cmd"
      else
        printf '%s %s %s\n' "$sched" "$user" "$cmd"
      fi
    done < <(jq -c '.cron // [] | .[]' "$STATE")
  } >"$dest"
  chmod 644 "$dest"
}

# --- backups ---------------------------------------------------------------
apply_backups() {
  [ "$DRY" -eq 1 ] && { log "would apply backup cron"; return; }
  ensure_cron_dir
  dest=/etc/cron.d/schela-backups
  {
    echo "SHELL=/bin/sh"
    echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    echo "MAILTO="
    while IFS= read -r job; do
      [ -n "$job" ] || continue
      enabled="$(jq -r '.enabled' <<<"$job")"
      [ "$enabled" = "true" ] || [ "$enabled" = "t" ] || [ "$enabled" = "1" ] || continue
      id="$(jq -r '.id' <<<"$job")"
      sched="$(jq -r '.schedule' <<<"$job")"
      [[ "$id" =~ ^[0-9]+$ ]] || continue
      [[ "$sched" =~ ^[0-9*/,[:space:]-]+$ ]] || continue
      printf '%s root /usr/local/sbin/schela-backup run %s\n' "$sched" "$id"
    done < <(jq -c '.backups // [] | .[]' "$STATE")
  } >"$dest"
  chmod 644 "$dest"
  mkdir -p /var/lib/schela/backups
  chown schela:schela /var/lib/schela/backups 2>/dev/null || true
}

# --- redis -----------------------------------------------------------------
redis_unit() {
  for u in redis-server redis; do
    if systemctl cat "${u}.service" >/dev/null 2>&1; then
      printf '%s' "$u"
      return
    fi
  done
  printf 'redis-server'
}

apply_redis() {
  unit="$(redis_unit)"
  if mod_on redis; then
    if [ "$DRY" -eq 1 ]; then
      log "would install/enable redis (${unit})"
      return
    fi
    if ! command -v redis-server >/dev/null 2>&1; then
      log "installing redis-server"
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y >/dev/null
      apt-get install -y --no-install-recommends redis-server \
        || apt-get install -y --no-install-recommends redis
      unit="$(redis_unit)"
    fi
    if [ -d /etc/redis ]; then
      passfile=/var/lib/schela/redis.pass
      if [ ! -s "$passfile" ]; then
        umask 077
        openssl rand -hex 24 >"$passfile"
      fi
      chown schela:schela "$passfile" 2>/dev/null || true
      chmod 600 "$passfile"
      rpass="$(tr -d '\n' <"$passfile")"
      [[ "$rpass" =~ ^[a-f0-9]{32,64}$ ]] || die "bad redis password file"
      cat >/etc/redis/schela.conf <<EOF
# Managed by schela-apply — localhost only. Package is never removed on disable.
bind 127.0.0.1
protected-mode yes
port 6379
supervised systemd
requirepass ${rpass}
rename-command FLUSHALL ""
rename-command FLUSHDB ""
rename-command CONFIG ""
EOF
      if id -u redis >/dev/null 2>&1; then
        chown root:redis /etc/redis/schela.conf
      else
        chown root:root /etc/redis/schela.conf
      fi
      chmod 640 /etc/redis/schela.conf
      if [ -f /etc/redis/redis.conf ] && ! grep -q '/etc/redis/schela.conf' /etc/redis/redis.conf; then
        printf '\ninclude /etc/redis/schela.conf\n' >>/etc/redis/redis.conf
      fi
    fi
    log "redis on — enable and start ${unit} (starts at boot)"
    systemctl unmask "$unit" >/dev/null 2>&1 || true
    systemctl enable "$unit"
    systemctl restart "$unit" || systemctl start "$unit"
  else
    if [ "$DRY" -eq 1 ]; then
      log "would stop redis (keep package, do not start at boot)"
      return
    fi
    # Never uninstall. Stop now and disable so a reboot does not bring it back.
    if systemctl cat redis-server.service >/dev/null 2>&1 || systemctl cat redis.service >/dev/null 2>&1; then
      log "redis off — stop ${unit}, disable boot start (package stays)"
      systemctl disable --now redis-server >/dev/null 2>&1 || true
      systemctl disable --now redis >/dev/null 2>&1 || true
    fi
  fi
}

# --- databases (MariaDB, PostgreSQL) ----------------------------------------
# The engine is installed when its module is turned on and only stopped when it
# is turned off: the package and the data stay. Databases, users and access are
# synced by schela-db, which never drops anything.
DB_SYNC="${SCHELA_DB:-/usr/local/sbin/schela-db}"
DB_FAILED=0

apt_install() {
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null
  apt-get install -y --no-install-recommends "$@"
}

# Write a managed config file; returns 0 when its content changed.
write_if_changed() {
  dest="$1"
  content="$2"
  if [ -f "$dest" ] && [ "$(cat "$dest")" = "$content" ]; then
    return 1
  fi
  printf '%s\n' "$content" >"$dest"
  chmod 644 "$dest"
  return 0
}

db_sync() {
  "$DB_SYNC" sync "$1" || { log "$1: database sync failed"; DB_FAILED=1; }
}

apply_mariadb() {
  if ! mod_on mariadb; then
    if [ "$DRY" -eq 1 ]; then
      log "would stop mariadb (keep package and data, no boot start)"
    elif [ -f /etc/mysql/mariadb.conf.d/99-schela.cnf ]; then
      # Only a server schela set up; a MariaDB installed by hand is left alone.
      log "mariadb off: stop, disable boot start (package and data stay)"
      systemctl disable --now mariadb >/dev/null 2>&1 || true
    fi
    return 0
  fi
  if [ "$DRY" -eq 1 ]; then
    log "would install/enable mariadb and sync databases"
    return 0
  fi
  if ! command -v mariadbd >/dev/null 2>&1 && [ ! -x /usr/sbin/mariadbd ]; then
    log "installing mariadb-server"
    apt_install mariadb-server mariadb-client
  fi
  restart=0
  mkdir -p /etc/mysql/mariadb.conf.d
  if write_if_changed /etc/mysql/mariadb.conf.d/99-schela.cnf "# Managed by schela-apply.
[mysqld]
bind-address = 127.0.0.1
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci"; then
    restart=1
  fi
  systemctl unmask mariadb >/dev/null 2>&1 || true
  systemctl enable mariadb >/dev/null 2>&1 || true
  if [ "$restart" -eq 1 ]; then
    systemctl restart mariadb || { log "mariadb did not start"; DB_FAILED=1; return 0; }
  else
    systemctl start mariadb || { log "mariadb did not start"; DB_FAILED=1; return 0; }
  fi
  for _ in $(seq 1 30); do
    mariadb-admin --protocol=socket ping >/dev/null 2>&1 && break
    sleep 1
  done
  db_sync mariadb
}

pg_conf_dir() {
  ls -d /etc/postgresql/*/main 2>/dev/null | sort -V | tail -1
}

apply_postgresql() {
  if ! mod_on postgresql; then
    if [ "$DRY" -eq 1 ]; then
      log "would stop postgresql (keep package and data, no boot start)"
    elif [ -n "$(pg_conf_dir)" ] && [ -f "$(pg_conf_dir)/conf.d/99-schela.conf" ]; then
      # Only a server schela set up; a PostgreSQL installed by hand is left alone.
      log "postgresql off: stop, disable boot start (package and data stay)"
      systemctl disable --now postgresql >/dev/null 2>&1 || true
    fi
    return 0
  fi
  if [ "$DRY" -eq 1 ]; then
    log "would install/enable postgresql and sync databases"
    return 0
  fi
  if ! ls /usr/lib/postgresql/*/bin/postgres >/dev/null 2>&1; then
    log "installing postgresql"
    apt_install postgresql postgresql-client
  fi
  conf="$(pg_conf_dir)"
  [ -n "$conf" ] || { log "postgresql: no cluster under /etc/postgresql"; DB_FAILED=1; return 0; }
  restart=0
  mkdir -p "$conf/conf.d"
  if write_if_changed "$conf/conf.d/99-schela.conf" "# Managed by schela-apply.
listen_addresses = 'localhost'
password_encryption = 'scram-sha-256'"; then
    restart=1
  fi
  systemctl unmask postgresql >/dev/null 2>&1 || true
  systemctl enable postgresql >/dev/null 2>&1 || true
  if [ "$restart" -eq 1 ]; then
    systemctl restart postgresql || { log "postgresql did not start"; DB_FAILED=1; return 0; }
  else
    systemctl start postgresql || { log "postgresql did not start"; DB_FAILED=1; return 0; }
  fi
  for _ in $(seq 1 30); do
    pg_isready -q >/dev/null 2>&1 && break
    sleep 1
  done
  db_sync postgresql
}

# --- search engines (Meilisearch, Typesense) ---------------------------------
# One local instance of each, bound to 127.0.0.1 and run by its own system user
# from the release pinned in versions.json, checked against its sha256. Sites
# get API keys limited to their own indexes through schela-search; the master
# key stays with root. Turning a module off stops the service; the binary, the
# data and the keys stay.
SEARCH_FAILED=0
SEARCH_SECRETS="${SCHELA_SEARCH_SECRETS:-/var/lib/schela/search}"
# Tests keep verified downloads here so each run does not fetch them again.
DOWNLOAD_CACHE="${SCHELA_DOWNLOAD_CACHE:-}"
SEARCH_MARK="# Managed by schela-apply."

search_arch() {
  case "$(uname -m)" in
    x86_64 | amd64) echo amd64 ;;
    aarch64 | arm64) echo arm64 ;;
    *) return 1 ;;
  esac
}

# fetch_verified URL SHA256 DEST: DEST is written only when the download matches.
fetch_verified() {
  local url="$1" sum="$2" dest="$3" part="$3.part"
  [[ "$sum" =~ ^[0-9a-f]{64}$ ]] || { log "no valid sha256 for $url"; return 1; }
  if [ -n "$DOWNLOAD_CACHE" ] && [ -f "$DOWNLOAD_CACHE/$sum" ]; then
    cp "$DOWNLOAD_CACHE/$sum" "$part"
  else
    curl -fsSL --retry 3 -o "$part" "$url" || { rm -f "$part"; log "download failed: $url"; return 1; }
  fi
  if ! printf '%s  %s\n' "$sum" "$part" | sha256sum -c - >/dev/null 2>&1; then
    rm -f "$part"
    log "checksum mismatch, refusing $url"
    return 1
  fi
  if [ -n "$DOWNLOAD_CACHE" ]; then
    mkdir -p "$DOWNLOAD_CACHE"
    cp "$part" "$DOWNLOAD_CACHE/$sum"
  fi
  mv -f "$part" "$dest"
}

# The root-only master key of an engine, made once.
search_secret() {
  local f="$SEARCH_SECRETS/$1.key" key
  install -d -m 0700 -o root -g root "$SEARCH_SECRETS"
  if [ ! -s "$f" ]; then
    (umask 077 && openssl rand -hex 32 >"$f")
  fi
  chown root:root "$f"
  chmod 600 "$f"
  key="$(tr -d '\n' <"$f")"
  [[ "$key" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s' "$key"
}

search_version() {
  local bin="$1"
  [ -x "$bin" ] || return 0
  # typesense-server prints "Typesense X" on stderr, then complains about the
  # missing config and exits non-zero.
  { "$bin" --version 2>&1 || true; } | awk '$1 == "meilisearch" || $1 == "Typesense" {print $2; exit}'
}

# version_newer A B: A is a later release than B.
version_newer() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

# Both engines rewrite their files when a new release first starts and cannot
# go back, so the data is copied aside first, with the service stopped.
search_keep_copy() {
  local unit="$1" data="$2" old="$3" home need avail
  home="$(dirname "$data")"
  [ -d "$data" ] && [ -n "$(ls -A "$data" 2>/dev/null)" ] || return 0
  need="$(du -sk "$data" | awk '{print $1}')"
  avail="$(df -Pk "$home" | awk 'NR == 2 {print $4}')"
  if [ "$avail" -le "$need" ]; then
    log "$unit: not enough free disk to keep a copy of $data before upgrading"
    return 1
  fi
  systemctl stop "$unit" >/dev/null 2>&1 || true
  rm -rf "$home"/pre-upgrade-*
  cp -a "$data" "$home/pre-upgrade-$old"
  log "$unit: data from $old kept in $home/pre-upgrade-$old"
}

# search_install ENGINE BIN VERSION URL SHA256 UNIT DATA
# Puts the pinned release at BIN. Returns 0 when BIN changed.
search_install() {
  local engine="$1" bin="$2" version="$3" url="$4" sum="$5" unit="$6" data="$7" installed tmp
  installed="$(search_version "$bin")"
  [ "$installed" = "$version" ] && return 1
  if [ -n "$installed" ] && version_newer "$installed" "$version"; then
    log "$engine: $installed is newer than the pinned $version; keeping it"
    return 1
  fi
  log "$engine: installing $version${installed:+ (was $installed)}"
  tmp="$(mktemp -d)"
  if ! fetch_verified "$url" "$sum" "$tmp/download"; then
    rm -rf "$tmp"
    return 2
  fi
  case "$url" in
    *.tar.gz)
      if ! tar -xzf "$tmp/download" -C "$tmp" "$(basename "$bin")"; then
        rm -rf "$tmp"
        log "$engine: $(basename "$bin") not found in the release archive"
        return 2
      fi
      ;;
    *) mv "$tmp/download" "$tmp/$(basename "$bin")" ;;
  esac
  if [ -n "$installed" ] && ! search_keep_copy "$unit" "$data" "$installed"; then
    rm -rf "$tmp"
    return 2
  fi
  install -m 0755 -o root -g root "$tmp/$(basename "$bin")" "$bin.new"
  mv -f "$bin.new" "$bin"
  rm -rf "$tmp"
  return 0
}

search_unit() {
  # search_unit DESCRIPTION USER HOME EXEC [EXTRA SERVICE LINES]
  cat <<UNIT
${SEARCH_MARK}
[Unit]
Description=$1
After=network.target

[Service]
Type=simple
User=$2
Group=$2
ExecStart=$4
Restart=on-failure
RestartSec=5
UMask=0077
${5:-}
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$3
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
UNIT
}

# write_owned DEST OWNER:GROUP MODE CONTENT -> 0 when the content changed.
write_owned() {
  local dest="$1" owner="$2" mode="$3" content="$4" changed=1
  if [ ! -f "$dest" ] || [ "$(cat "$dest")" != "$content" ]; then
    (umask 077 && printf '%s\n' "$content" >"$dest.tmp")
    mv -f "$dest.tmp" "$dest"
    changed=0
  fi
  chown "$owner" "$dest"
  chmod "$mode" "$dest"
  return "$changed"
}

# apply_search ENGINE
apply_search() {
  local engine="$1" user home data bin unit unitfile url arch version sum key cfg cfgfile exec extra
  local restart=0 rc
  case "$engine" in
    meilisearch)
      user=meilisearch home=/var/lib/meilisearch data=/var/lib/meilisearch/data
      bin=/usr/local/bin/meilisearch unit=meilisearch cfgfile=/etc/meilisearch.toml
      ;;
    typesense)
      user=typesense home=/var/lib/typesense data=/var/lib/typesense/data
      bin=/usr/local/bin/typesense-server unit=typesense cfgfile=/etc/typesense/typesense-server.ini
      ;;
    *) return 0 ;;
  esac
  unitfile="$SYSTEMD_DIR/$unit.service"

  if ! mod_on "$engine"; then
    if [ "$DRY" -eq 1 ]; then
      log "would stop $engine (keep binary, data and keys, no boot start)"
    elif [ -f "$unitfile" ] && grep -qxF "$SEARCH_MARK" "$unitfile"; then
      log "$engine off: stop, disable boot start (binary, data and keys stay)"
      systemctl disable --now "$unit" >/dev/null 2>&1 || true
    fi
    return 0
  fi

  version="$(jq -r --arg e "$engine" '.[$e].version // empty' "$VERSIONS")"
  if ! [[ "$version" =~ ^[0-9]+(\.[0-9]+){1,2}$ ]]; then
    log "$engine: no version in $VERSIONS"
    SEARCH_FAILED=1
    return 0
  fi
  if [ "$DRY" -eq 1 ]; then
    log "would install/enable $engine $version"
    return 0
  fi
  if [ -f "$unitfile" ] && ! grep -qxF "$SEARCH_MARK" "$unitfile"; then
    log "$engine: $unitfile was not written by schela; leaving it alone"
    SEARCH_FAILED=1
    return 0
  fi
  if ! arch="$(search_arch)"; then
    log "$engine: no release for $(uname -m)"
    SEARCH_FAILED=1
    return 0
  fi
  sum="$(jq -r --arg e "$engine" --arg a "$arch" '.[$e].sha256[$a] // empty' "$VERSIONS")"
  case "$engine" in
    meilisearch)
      url="https://github.com/meilisearch/meilisearch/releases/download/v${version}/meilisearch-linux-${arch/arm64/aarch64}"
      ;;
    typesense)
      url="https://dl.typesense.org/releases/${version}/typesense-server-${version}-linux-${arch}.tar.gz"
      ;;
  esac

  if ! id -u "$user" >/dev/null 2>&1; then
    useradd --system --user-group --home-dir "$home" --no-create-home --shell "$(nologin_shell)" "$user"
  fi
  install -d -m 0750 -o "$user" -g "$user" "$home" "$data"
  if [ "$engine" = meilisearch ]; then
    install -d -m 0750 -o "$user" -g "$user" "$home/dumps" "$home/snapshots" "$home/tmp"
  fi
  if ! key="$(search_secret "$engine")"; then
    log "$engine: bad master key in $SEARCH_SECRETS/$engine.key"
    SEARCH_FAILED=1
    return 0
  fi

  rc=0
  search_install "$engine" "$bin" "$version" "$url" "$sum" "$unit" "$data" || rc=$?
  case "$rc" in
    0) restart=1 ;;
    1) ;;
    *)
      SEARCH_FAILED=1
      return 0
      ;;
  esac
  if [ ! -x "$bin" ]; then
    SEARCH_FAILED=1
    return 0
  fi

  case "$engine" in
    meilisearch)
      cfg="${SEARCH_MARK}
env = \"production\"
master_key = \"${key}\"
db_path = \"${data}\"
dump_dir = \"${home}/dumps\"
snapshot_dir = \"${home}/snapshots\"
http_addr = \"127.0.0.1:7700\"
no_analytics = true"
      # --upgrade-db lets a newer release migrate the data on its first start;
      # on an up-to-date database it does nothing.
      exec="$bin --config-file-path $cfgfile --upgrade-db"
      extra="Environment=TMPDIR=${home}/tmp"
      ;;
    typesense)
      mkdir -p "$(dirname "$cfgfile")"
      cfg="${SEARCH_MARK}
[server]
api-address = 127.0.0.1
api-port = 8108
data-dir = ${data}
api-key = ${key}"
      exec="$bin --config=$cfgfile"
      # The limits of the vendor's own unit.
      extra="LimitNOFILE=64000
LimitMEMLOCK=infinity"
      ;;
  esac
  write_owned "$cfgfile" "root:$user" 0640 "$cfg" && restart=1
  if write_owned "$unitfile" root:root 0644 "$(search_unit "$engine (managed by Schela)" "$user" "$home" "$exec" "$extra")"; then
    systemctl daemon-reload
    restart=1
  fi

  systemctl unmask "$unit" >/dev/null 2>&1 || true
  systemctl enable "$unit" >/dev/null 2>&1 || true
  if [ "$restart" -eq 1 ]; then
    log "$engine $version: restart"
    systemctl restart "$unit" || { log "$engine did not start"; SEARCH_FAILED=1; }
  else
    systemctl start "$unit" || { log "$engine did not start"; SEARCH_FAILED=1; }
  fi
}

# --- dns -------------------------------------------------------------------
apply_dns() {
  mod_on dns || return 0
  [ -d /etc/bind ] || return 0
  [ "$DRY" -eq 1 ] && { log "would apply bind zones"; return; }
  # Root writes the zones; named (user bind) reads them. They live under
  # /var/lib/bind because named's AppArmor profile (Ubuntu, Debian) only lets
  # it read zone files from its own directories.
  local zdir=/var/lib/bind/schela
  if getent group bind >/dev/null 2>&1; then
    install -d -m 0750 -o root -g bind "$zdir"
  else
    install -d -m 0755 -o root -g root "$zdir"
  fi
  # Zones used to be written here, where named could not read them.
  rm -rf /var/lib/schela/bind
  : >/etc/bind/schela-zones.conf
  while IFS= read -r zone; do
    [ -n "$zone" ] || continue
    zname="$(jq -r '.name' <<<"$zone")"
    serial="$(jq -r '.serial' <<<"$zone")"
    ok_domain "$zname" || continue
    [[ "$serial" =~ ^[0-9]+$ ]] || serial="$(date +%Y%m%d01)"
    zfile="${zdir}/${zname}.zone"
    dkim_p=""
    [ -f "/var/lib/schela/dkim/${zname}.txt" ] && dkim_p="$(dkim_key "/var/lib/schela/dkim/${zname}.txt")"
    {
      echo "\$TTL 300"
      echo "@ IN SOA ns1.${zname}. hostmaster.${zname}. (${serial} 3600 600 86400 300)"
      while IFS= read -r rec; do
        [ -n "$rec" ] || continue
        t="$(jq -r '.type' <<<"$rec")"
        n="$(jq -r '.name' <<<"$rec")"
        v="$(jq -r '.value' <<<"$rec")"
        ttl="$(jq -r '.ttl' <<<"$rec")"
        prio="$(jq -r '.priority // empty' <<<"$rec")"
        [[ "$t" =~ ^(A|AAAA|CNAME|MX|TXT|NS)$ ]] || continue
        [[ "$n" =~ ^[@A-Za-z0-9._*-]+$ ]] || continue
        [[ "$ttl" =~ ^[0-9]+$ ]] || ttl=300
        # The panel stores a placeholder DKIM record; the real key replaces it.
        [ -n "$dkim_p" ] && [ "$t" = "TXT" ] && [ "$n" = "mail._domainkey" ] && continue
        v="${v//$'\n'/}"
        v="${v//\"/}"
        if [ "$t" = "MX" ]; then
          [[ "$prio" =~ ^[0-9]+$ ]] || prio=10
          echo "${n} ${ttl} IN MX ${prio} $(fqdn "$v")"
        elif [ "$t" = "TXT" ]; then
          echo "${n} ${ttl} IN TXT $(txt_strings "$v")"
        elif [ "$t" = "NS" ] || [ "$t" = "CNAME" ]; then
          echo "${n} ${ttl} IN ${t} $(fqdn "$v")"
        else
          echo "${n} ${ttl} IN ${t} ${v}"
        fi
      done < <(jq -c '.records // [] | .[]' <<<"$zone")
      ns_glue "$zone" "$zname"
      if [ -n "$dkim_p" ]; then
        echo "mail._domainkey 300 IN TXT $(txt_strings "v=DKIM1; k=rsa; p=${dkim_p}")"
      fi
    } >"$zfile"
    chmod 644 "$zfile"
    echo "zone \"${zname}\" { type master; file \"${zfile}\"; };" >>/etc/bind/schela-zones.conf
  done < <(jq -c '.dns.zones // [] | .[]' "$STATE")
  # A zone deleted in the panel is no longer listed; its file goes too.
  local zf
  for zf in "$zdir"/*.zone; do
    [ -f "$zf" ] || continue
    grep -qF "file \"${zf}\";" /etc/bind/schela-zones.conf || rm -f "$zf"
  done
  grep -q 'schela-zones.conf' /etc/bind/named.conf.local 2>/dev/null || \
    echo 'include "/etc/bind/schela-zones.conf";' >>/etc/bind/named.conf.local
  named-checkconf >/dev/null 2>&1 && systemctl reload bind9 >/dev/null 2>&1 || true
}

# --- certificates ------------------------------------------------------------
# nginx answers http-01 challenges from here for every Host on port 80.
prepare_acme_root() {
  mkdir -p "$ACME_ROOT/.well-known/acme-challenge"
  chmod 755 /var/lib/schela "$ACME_ROOT" "$ACME_ROOT/.well-known" "$ACME_ROOT/.well-known/acme-challenge" || true
}

# certbot webroot issuance for one name. Output goes to the file in $2.
certbot_webroot() {
  certbot certonly --webroot -w "$ACME_ROOT" \
    -d "$1" \
    --non-interactive --agree-tos \
    --register-unsafely-without-email \
    --preferred-challenges http \
    --keep-until-expiring \
    >"$2" 2>&1
}

cert_expires() {
  openssl x509 -enddate -noout -in "$1" 2>/dev/null | sed 's/notAfter=//' || true
}

issue_certs() {
  [ "$DRY" -eq 0 ] || return 0
  command -v certbot >/dev/null 2>&1 || { log "certbot missing"; return 0; }
  prepare_acme_root
  echo '{' >"$CERTS_JSON.tmp"
  first=1
  NEW_CERTS=0
  for domain in "${SSL_DOMAINS[@]+"${SSL_DOMAINS[@]}"}"; do
    [ -n "$domain" ] || continue
    status="pending"
    message="Waiting for Let's Encrypt"
    expires=""
    if cert_live "$domain"; then
      status="live"
      message="Certificate is active"
      expires="$(cert_expires "/etc/letsencrypt/live/${domain}/fullchain.pem")"
    else
      out="$(mktemp)"
      set +e
      certbot_webroot "$domain" "$out"
      rc=$?
      set -e
      if [ "$rc" -eq 0 ] && cert_live "$domain"; then
        status="live"
        message="Certificate issued"
        expires="$(cert_expires "/etc/letsencrypt/live/${domain}/fullchain.pem")"
        NEW_CERTS=$((NEW_CERTS + 1))
        log "certificate issued for $domain"
      else
        status="error"
        message="$(tail -n 8 "$out" | tr '\n' ' ' | sed 's/"/\\"/g' | cut -c1-400)"
        [ -n "$message" ] || message="Let's Encrypt failed (is DNS pointing here? port 80 open?)"
        log "certbot failed for $domain: $message"
        mkdir -p /var/log/schela
        cp "$out" "/var/log/schela/certbot-${domain}.log" || true
      fi
      rm -f "$out"
    fi
    [ "$first" -eq 1 ] || echo ',' >>"$CERTS_JSON.tmp"
    first=0
    printf '"%s":{"status":"%s","message":"%s","expires":"%s"}\n' \
      "$domain" "$status" "$message" "$expires" >>"$CERTS_JSON.tmp"
  done
  echo '}' >>"$CERTS_JSON.tmp"
  mv "$CERTS_JSON.tmp" "$CERTS_JSON"
  chmod 644 "$CERTS_JSON"
}

# --- panel host certificate --------------------------------------------------
# /var/lib/schela/tls/host.crt (full chain) and host.key (root only) always
# hold the certificate for settings.hostname: Let's Encrypt when one is live,
# else the self-signed one. Dovecot and Postfix read these two paths. The
# panel by IP always uses the self-signed certificate: Let's Encrypt does not
# issue for a bare IP with the certbot of any supported system (1.21 to 4.0
# refuse "Requested name ... is an IP address").
TLS_DIR="/var/lib/schela/tls"
PANEL_CONF="/etc/nginx/sites-available/schela-panel.conf"
DEPLOY_HOOK="/etc/letsencrypt/renewal-hooks/deploy/schela"
HOST_CERT_KIND="self-signed"
PANEL_VHOST_CHANGED=0
PANEL_IPS=()

# settings.hostname, else this machine's name. Never empty.
panel_hostname() {
  local h
  h="$(jq -r '.settings.hostname // empty' "$STATE" 2>/dev/null || true)"
  h="${h%.}"
  h="${h,,}"
  if ok_domain "$h" && ! ok_ipv4 "$h"; then printf '%s' "$h"; return; fi
  h="$(hostname -f 2>/dev/null || hostname 2>/dev/null || true)"
  h="${h,,}"
  if ok_domain "$h" && ! ok_ipv4 "$h"; then printf '%s' "$h"; return; fi
  printf 'localhost'
}

# Addresses on this machine's interfaces (no loopback, no link-local).
panel_ips() {
  local ip
  for ip in $(hostname -I 2>/dev/null || true); do
    if ok_ipv4 "$ip" || [[ "$ip" =~ ^[0-9A-Fa-f:]+$ && "$ip" == *:* ]]; then
      printf '%s\n' "${ip,,}"
    fi
  done | awk '!seen[$0]++'
}

panel_port() {
  local p="${SCHELA_PANEL_PORT:-}"
  [ -n "$p" ] || p="$(sed -n 's/^Environment=PORT=\([0-9]*\)$/\1/p' /etc/systemd/system/schela-panel.service 2>/dev/null | head -n1)"
  ok_port "$p" || p=9090
  printf '%s' "$p"
}

# nginx 1.19.4 added ssl_reject_handshake; Ubuntu 22.04 ships 1.18.
nginx_reject_handshake() {
  local v
  v="$(nginx -v 2>&1 | sed -n 's|.*nginx/\([0-9][0-9.]*\).*|\1|p')"
  [ -n "$v" ] || return 1
  [ "$(printf '%s\n1.19.4\n' "$v" | sort -V | head -n1)" = "1.19.4" ]
}

# The listen lines of a panel server on 443, IPv4 and IPv6.
panel_listen_443() {
  local opt="${1:+ $1}" h2=" http2" tail=""
  if [ "${HTTP2_DIRECTIVE:-0}" -eq 1 ]; then
    h2=""
    tail=$';\n    http2 on'
  fi
  printf '443 ssl%s%s;\n    listen [::]:443 ssl%s%s%s' "$h2" "$opt" "$h2" "$opt" "$tail"
}

# The panel user owns /var/lib/schela and could put a link or its own
# directory at tls; root only writes into a root-owned directory.
prepare_tls_dir() {
  if [ -L "$TLS_DIR" ] || { [ -e "$TLS_DIR" ] && [ "$(stat -c %u "$TLS_DIR")" != "0" ]; }; then
    rm -rf "$TLS_DIR"
  fi
  install -d -m 0755 -o root -g root "$TLS_DIR"
}

# Self-signed certificate for the hostname and every address, renewed when
# those change or it is 30 days from expiry.
ensure_self_signed() {
  local host="$1" san ip tmp
  shift
  san="DNS:${host}"
  for ip in "$@"; do san+=",IP:${ip}"; done
  if [ -s "$TLS_DIR/self-signed.crt" ] && [ -s "$TLS_DIR/self-signed.key" ] \
    && [ "$(cat "$TLS_DIR/self-signed.san" 2>/dev/null)" = "$san" ] \
    && openssl x509 -checkend 2592000 -noout -in "$TLS_DIR/self-signed.crt" >/dev/null 2>&1; then
    return 0
  fi
  tmp="$(mktemp -d "$TLS_DIR/.new.XXXXXX")"
  if ! openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=${host}" \
    -addext "subjectAltName=${san}" -keyout "$tmp/key" -out "$tmp/crt" >/dev/null 2>&1; then
    rm -rf "$tmp"
    die "could not create the self-signed certificate for ${san}"
  fi
  chmod 600 "$tmp/key"
  chmod 644 "$tmp/crt"
  mv -f "$tmp/key" "$TLS_DIR/self-signed.key"
  mv -f "$tmp/crt" "$TLS_DIR/self-signed.crt"
  printf '%s\n' "$san" >"$TLS_DIR/self-signed.san"
  rm -rf "$tmp"
  log "self-signed certificate for ${san}"
}

# Copy a certificate and its key to the contract paths (no-op when equal).
install_host_files() {
  local crt="$1" key="$2"
  if cmp -s "$crt" "$TLS_DIR/host.crt" && cmp -s "$key" "$TLS_DIR/host.key"; then
    return 0
  fi
  install -m 0600 -o root -g root "$key" "$TLS_DIR/.host.key.new"
  install -m 0644 -o root -g root "$crt" "$TLS_DIR/.host.crt.new"
  mv -f "$TLS_DIR/.host.key.new" "$TLS_DIR/host.key"
  mv -f "$TLS_DIR/.host.crt.new" "$TLS_DIR/host.crt"
  log "host certificate: $crt"
}

le_valid() {
  cert_live "$1" && openssl x509 -checkend 0 -noout -in "/etc/letsencrypt/live/${1}/fullchain.pem" >/dev/null 2>&1
}

# Names Let's Encrypt could issue for: a dotted public name and certbot here.
le_eligible() {
  command -v certbot >/dev/null 2>&1 || return 1
  [[ "$1" == *.* ]] || return 1
  [[ ! "$1" =~ \.(example|local|test|localhost|invalid|internal|lan)$ ]]
}

# Does the hostname reach this machine? Public DNS only (not /etc/hosts, which
# often maps it to 127.0.1.1): yes when it resolves to an address of this
# machine, or, behind NAT, when nginx here answers a token through it.
host_points_here() {
  local host="$1" addr token got rc=1
  local -a addrs=()
  mapfile -t addrs < <(getent -s dns ahosts "$host" 2>/dev/null | awk '{print tolower($1)}' | sort -u)
  [ "${#addrs[@]}" -gt 0 ] || return 1
  for addr in "${addrs[@]}"; do
    in_list "$addr" "${PANEL_IPS[@]+"${PANEL_IPS[@]}"}" && return 0
  done
  command -v curl >/dev/null 2>&1 || return 1
  token="schela-check-$(openssl rand -hex 16)"
  printf '%s' "$token" >"$ACME_ROOT/.well-known/acme-challenge/$token"
  for addr in "${addrs[@]}"; do
    [[ "$addr" == *:* ]] && addr="[$addr]"
    got="$(curl -s --max-time 5 --resolve "${host}:80:${addr}" \
      "http://${host}/.well-known/acme-challenge/${token}" 2>/dev/null || true)"
    if [ "$got" = "$token" ]; then rc=0; break; fi
  done
  rm -f "$ACME_ROOT/.well-known/acme-challenge/$token"
  return "$rc"
}

# Write the panel vhost for the current HOST_CERT_KIND. A config nginx refuses
# is rolled back, so a bad render never replaces a working panel.
write_panel_vhost() {
  local host="$1" names ip ip_names="" hsts="" reject conf old="" was_ok=0
  for ip in "${PANEL_IPS[@]+"${PANEL_IPS[@]}"}"; do
    if [[ "$ip" == *:* ]]; then ip_names+=" [${ip}]"; else ip_names+=" ${ip}"; fi
  done
  ip_names="${ip_names# }"
  names="${host}${ip_names:+ ${ip_names}}"
  [ -n "$ip_names" ] || ip_names="_"
  # HSTS only with a publicly trusted certificate, and only for the hostname:
  # no includeSubDomains, site domains may be subdomains of it.
  if [ "$HOST_CERT_KIND" = "letsencrypt" ]; then
    hsts='    add_header Strict-Transport-Security "max-age=31536000" always;'
  fi
  if nginx_reject_handshake; then
    reject='    ssl_reject_handshake on;'
  else
    reject="    ssl_certificate ${TLS_DIR}/self-signed.crt;"$'\n'"    ssl_certificate_key ${TLS_DIR}/self-signed.key;"
  fi
  conf="$(render "$TEMPLATES/nginx-panel.conf" \
    __LISTEN_443_DEFAULT__ "$(panel_listen_443 default_server)" \
    __LISTEN_443__ "$(panel_listen_443)" \
    __PANEL_NAMES__ "$names" \
    __IP_NAMES__ "$ip_names" \
    __HOSTNAME__ "$host" \
    __REJECT_TLS__ "$reject" \
    __HSTS__ "$hsts" \
    __PANEL_PORT__ "$(panel_port)")"
  [ -f "$PANEL_CONF" ] && old="$(cat "$PANEL_CONF")"
  if [ "$old" = "$conf" ] && [ -L /etc/nginx/sites-enabled/schela-panel.conf ]; then
    return 0
  fi
  # The distro welcome page is also default_server on port 80.
  rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-enabled/default.conf /etc/nginx/conf.d/default.conf
  # Only roll back what this render broke: when nginx already fails on
  # something else, the rest of apply is what repairs it.
  nginx -t >/dev/null 2>&1 && was_ok=1
  write_file "$PANEL_CONF" "$conf"
  ln -sfn "$PANEL_CONF" /etc/nginx/sites-enabled/schela-panel.conf
  PANEL_VHOST_CHANGED=1
  if [ "$was_ok" -eq 1 ] && ! nginx -t >/dev/null 2>&1; then
    nginx -t || true
    if [ -n "$old" ]; then
      write_file "$PANEL_CONF" "$old"
    else
      rm -f "$PANEL_CONF" /etc/nginx/sites-enabled/schela-panel.conf
    fi
    die "nginx refused the panel vhost; kept the previous one"
  fi
}

install_deploy_hook() {
  local body
  body='#!/bin/sh
# Installed by schela-apply. certbot runs this after each renewal: it refreshes
# the panel host certificate and certs.json, then reloads nginx, Dovecot and
# Postfix.
exec /usr/local/sbin/schela-apply --renew-hook'
  mkdir -p "${DEPLOY_HOOK%/*}"
  if [ "$(cat "$DEPLOY_HOOK" 2>/dev/null)" != "$body" ]; then
    printf '%s\n' "$body" >"$DEPLOY_HOOK.tmp"
    chmod 755 "$DEPLOY_HOOK.tmp"
    mv -f "$DEPLOY_HOOK.tmp" "$DEPLOY_HOOK"
  fi
}

reload_nginx_quiet() {
  nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
}

ensure_host_cert() {
  local host url ip certlog rc
  host="$(panel_hostname)"
  mapfile -t PANEL_IPS < <(panel_ips)
  if [ "$DRY" -eq 1 ]; then
    log "would ensure the host certificate for $host and the panel vhost"
    return 0
  fi
  need openssl
  prepare_tls_dir
  prepare_acme_root
  ensure_self_signed "$host" "${PANEL_IPS[@]+"${PANEL_IPS[@]}"}"
  HOST_CERT_KIND="self-signed"
  if le_valid "$host"; then
    HOST_CERT_KIND="letsencrypt"
  elif le_eligible "$host"; then
    # nginx has to answer the challenge for this name on port 80 first.
    [ -s "$TLS_DIR/host.crt" ] && [ -s "$TLS_DIR/host.key" ] \
      || install_host_files "$TLS_DIR/self-signed.crt" "$TLS_DIR/self-signed.key"
    PANEL_VHOST_CHANGED=0
    write_panel_vhost "$host"
    [ "$PANEL_VHOST_CHANGED" -eq 0 ] || reload_nginx_quiet
    if host_points_here "$host"; then
      certlog="$(mktemp)"
      set +e
      certbot_webroot "$host" "$certlog"
      rc=$?
      set -e
      if [ "$rc" -eq 0 ] && le_valid "$host"; then
        HOST_CERT_KIND="letsencrypt"
        log "certificate issued for $host"
      else
        log "certbot failed for $host, the panel keeps the self-signed certificate"
        mkdir -p /var/log/schela
        cp "$certlog" "/var/log/schela/certbot-${host}.log" || true
      fi
      rm -f "$certlog"
    else
      log "$host does not point here, the panel uses the self-signed certificate"
    fi
  fi
  if [ "$HOST_CERT_KIND" = "letsencrypt" ]; then
    install_host_files "/etc/letsencrypt/live/${host}/fullchain.pem" "/etc/letsencrypt/live/${host}/privkey.pem"
    url="https://${host}/"
  else
    install_host_files "$TLS_DIR/self-signed.crt" "$TLS_DIR/self-signed.key"
    ip="${PANEL_IPS[0]:-}"
    if [ -z "$ip" ]; then
      url="https://${host}/"
    elif [[ "$ip" == *:* ]]; then
      url="https://[${ip}]/"
    else
      url="https://${ip}/"
    fi
  fi
  write_file "$TLS_DIR/host.env" "$(printf 'kind=%s\nhostname=%s\nurl=%s' "$HOST_CERT_KIND" "$host" "$url")"
  write_panel_vhost "$host"
  install_deploy_hook
}

# certs.json after a renewal: every name with a live certificate gets its new
# expiry date.
refresh_certs_json() {
  local json d exp tmp
  [ -f "$CERTS_JSON" ] || return 0
  json="$(cat "$CERTS_JSON")"
  jq -e 'type == "object"' <<<"$json" >/dev/null 2>&1 || return 0
  while IFS= read -r d; do
    ok_domain "$d" && cert_live "$d" || continue
    exp="$(cert_expires "/etc/letsencrypt/live/${d}/fullchain.pem")"
    json="$(jq --arg d "$d" --arg e "$exp" \
      '.[$d] = {status: "live", message: "Certificate is active", expires: $e}' <<<"$json")"
  done < <(jq -r 'keys[]' <<<"$json")
  tmp="$(mktemp "$CERTS_JSON.XXXXXX")"
  printf '%s\n' "$json" >"$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$CERTS_JSON"
}

# certbot deploy hook: RENEWED_LINEAGE is the live directory just renewed.
renew_hook() {
  local host rc=0 unit
  host="$(panel_hostname)"
  if [ "${RENEWED_LINEAGE:-}" = "/etc/letsencrypt/live/${host}" ] && cert_live "$host"; then
    prepare_tls_dir
    install_host_files "/etc/letsencrypt/live/${host}/fullchain.pem" "/etc/letsencrypt/live/${host}/privkey.pem"
  fi
  refresh_certs_json
  if nginx -t; then
    systemctl reload nginx || rc=1
  else
    log "nginx -t failed, nginx not reloaded"
    rc=1
  fi
  for unit in dovecot postfix; do
    if systemctl is-active --quiet "$unit"; then
      systemctl reload "$unit" || rc=1
    fi
  done
  log "renewal of ${RENEWED_LINEAGE:-unknown} deployed"
  return "$rc"
}

case "$MODE" in
  panel)
    ensure_host_cert
    nginx -t
    systemctl reload nginx || systemctl restart nginx
    log "panel on https with the $HOST_CERT_KIND certificate"
    exit 0
    ;;
  renew-hook)
    renew_hook || exit 1
    exit 0
    ;;
esac

log "applying $(jq -r '.settings.hostname // "unknown"' "$STATE")"
ensure_host_cert
apply_sites
apply_apps
apply_workers
apply_firewall
apply_auto_updates
apply_mail
apply_dns
apply_cron
apply_backups
apply_redis
apply_mariadb
apply_postgresql
apply_search meilisearch
apply_search typesense
apply_fail2ban

if [ "$DRY" -eq 0 ]; then
  mkdir -p "$ACME_ROOT/.well-known/acme-challenge"
  nginx -t
  systemctl reload nginx
  NEW_CERTS=0
  issue_certs
  if [ "${NEW_CERTS:-0}" -gt 0 ]; then
    log "attaching TLS vhosts"
    apply_sites
    apply_apps
    nginx -t
    systemctl reload nginx
  fi
fi
# A failed database sync must not hold back nginx and TLS, but the panel
# still has to hear about it.
[ "$DB_FAILED" -eq 0 ] || die "database changes were not fully applied (see the log above)"
[ "$SEARCH_FAILED" -eq 0 ] || die "search engine changes were not fully applied (see the log above)"
log "done"
