#!/bin/bash
# Apply /var/lib/schela/state.json onto this machine. Idempotent. Root only.
set -euo pipefail

STATE="${SCHELA_STATE:-/var/lib/schela/state.json}"
TEMPLATES="${SCHELA_TEMPLATES:-/usr/local/share/schela/templates}"
# PHP and Node versions the panel knows: supported ones plus retired ones that
# existing sites and apps may still run on.
VERSIONS="${SCHELA_VERSIONS:-/usr/local/share/schela/versions.json}"
DRY=0
# --panel: only the panel certificate and vhost (install.sh, schela fix).
# --renew-hook: run by certbot after a renewal (see install_deploy_hook).
MODE=apply
case "${1:-}" in
  --dry-run) DRY=1 ;;
  --panel) MODE=panel ;;
  --renew-hook) MODE=renew-hook ;;
esac

log() { printf 'schela-apply: %s\n' "$*"; }
die() { printf 'schela-apply: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing $1"; }

ok_domain() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]]; }
ok_user()   { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }
ok_php()    { [[ "$1" =~ ^[0-9]+\.[0-9]+$ ]] && in_list "$1" "${PHP_KNOWN[@]}"; }
ok_node()   { [[ "$1" =~ ^[0-9]+$ ]] && in_list "$1" "${NODE_KNOWN[@]}"; }
in_list()   { local want="$1" v; shift; for v in "$@"; do [ "$v" = "$want" ] && return 0; done; return 1; }
ok_port()   { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
ok_ipv4()   { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }

# A TXT value as bind wants it: quoted strings of at most 255 bytes each.
txt_strings() {
  local v="$1" out=""
  [ -n "$v" ] || { printf '""'; return; }
  while [ -n "$v" ]; do
    out+="\"${v:0:255}\" "
    v="${v:255}"
  done
  printf '%s' "${out% }"
}

# The public key from an opendkim-genkey zone snippet:
#   mail._domainkey IN TXT ( "v=DKIM1; h=sha256; k=rsa; " "p=MIIB..." "..." )
# Only the quoted text counts; tabs and parentheses around it are dropped.
dkim_key() {
  grep -o '"[^"]*"' "$1" | tr -d '"\n\t ' | sed -n 's/.*p=\([^;]*\).*/\1/p' || true
}

# A hostname as an absolute zone-file name. Without the final dot bind appends
# the zone: "ns1.example.com" in example.com becomes ns1.example.com.example.com.
fqdn() {
  printf '%s.' "${1%.}"
}

# A records for name servers inside the zone that have none, e.g.
# ns1.example.com in example.com. Bind refuses a zone whose own name server has
# no address. They point at the zone's apex A record; no apex A, no glue.
#   ns_glue <zone json> <zone name>
ns_glue() {
  local zone="$1" zname="$2" apex ns host
  apex="$(jq -r '[.records[]? | select(.type == "A" and .name == "@") | .value][0] // empty' <<<"$zone")"
  ok_ipv4 "$apex" || return 0
  while IFS= read -r ns; do
    ns="${ns%.}"
    case "$ns" in
      *."$zname") host="${ns%."$zname"}" ;;
      *) continue ;;
    esac
    [[ "$host" =~ ^[A-Za-z0-9-]+$ ]] || continue
    if ! jq -e --arg h "$host" 'any(.records[]?; .type == "A" and .name == $h)' <<<"$zone" >/dev/null; then
      echo "${host} 300 IN A ${apex}"
    fi
  done < <(jq -r '.records[]? | select(.type == "NS") | .value' <<<"$zone" | sort -u)
}

bind_http() {
  ip="${1:-}"
  if ok_ipv4 "$ip"; then
    printf '%s:80' "$ip"
  else
    printf '80;\n    listen [::]:80'
  fi
}

# nginx 1.25.1 moved HTTP/2 from a `listen` flag to its own `http2 on;`
# directive and warns about the flag; older nginx does not know the directive.
nginx_http2_directive() {
  local v
  v="$(nginx -v 2>&1 | sed -n 's|.*nginx/\([0-9][0-9.]*\).*|\1|p')"
  [ -n "$v" ] || return 1
  [ "$(printf '%s\n1.25.1\n' "$v" | sort -V | head -n1)" = "1.25.1" ]
}

bind_https() {
  ip="${1:-}"
  local h2=" http2" tail=""
  if [ "${HTTP2_DIRECTIVE:-0}" -eq 1 ]; then
    h2=""
    tail=";\n    http2 on"
  fi
  if ok_ipv4 "$ip"; then
    printf '%s:443 ssl%s%b' "$ip" "$h2" "$tail"
  else
    printf '443 ssl%s;\n    listen [::]:443 ssl%s%b' "$h2" "$h2" "$tail"
  fi
}

nologin_shell() { command -v nologin 2>/dev/null || echo /usr/sbin/nologin; }

# Run a command as a site user. Everything below /home/<user> belongs to that
# user, who can replace any entry there (for example turn www into a symlink),
# so files inside the home are created and changed with the user's own
# permissions, never root's.
as_user() {
  local user="$1"
  shift
  runuser -u "$user" -- "$@"
}

# /home/<user> itself: created by root if missing (useradd normally does it).
# /home is root-owned, so only root could have made this path a link; refuse
# one rather than change whatever it points at.
ensure_home() {
  local user="$1" home="/home/$1"
  if [ -L "$home" ]; then
    log "skip $user: $home is a symlink"
    return 1
  fi
  [ -d "$home" ] || install -d -o "$user" -g "$user" -m 750 "$home"
  chown "$user:$user" "$home"
  chmod 750 "$home"
}

[ "$(id -u)" -eq 0 ] || die "root required"
# One apply at a time. The panel starts one per change, and two at once race
# on users, unit files and configs. A later apply waits its turn, then applies
# the newest state.
# The renewal hook skips the lock: certbot can run it from inside an apply
# (certonly renewing an existing lineage), which already holds the lock.
if [ "$DRY" -eq 0 ] && [ "$MODE" != "renew-hook" ]; then
  exec 9>"${SCHELA_APPLY_LOCK:-/run/schela-apply.lock}"
  flock 9
fi
need jq
need nginx
[ -f "$STATE" ] || die "no state at $STATE"
[ -r "$VERSIONS" ] || die "no version catalog at $VERSIONS"
mapfile -t PHP_KNOWN < <(jq -r '.php.supported[], .php.retired[]' "$VERSIONS")
mapfile -t NODE_KNOWN < <(jq -r '.node.supported[], .node.retired[]' "$VERSIONS")
[ "${#PHP_KNOWN[@]}" -gt 0 ] && [ "${#NODE_KNOWN[@]}" -gt 0 ] || die "bad version catalog at $VERSIONS"
HTTP2_DIRECTIVE=0
nginx_http2_directive && HTTP2_DIRECTIVE=1

mod_on() {
  jq -e --arg s "$1" '.modules[$s] == true' "$STATE" >/dev/null 2>&1
}

write_file() {
  dest="$1"
  content="$2"
  if [ "$DRY" -eq 1 ]; then
    log "would write $dest"
    return
  fi
  tmp="$(mktemp)"
  printf '%s\n' "$content" >"$tmp"
  install -m 0644 "$tmp" "$dest"
  rm -f "$tmp"
}

render() {
  src="$1"
  shift
  out="$(cat "$src")"
  while [ "$#" -ge 2 ]; do
    out="${out//$1/$2}"
    shift 2
  done
  printf '%s' "$out"
}

ACME_ROOT="/var/lib/schela/acme"
CERTS_JSON="/var/lib/schela/certs.json"

wants_ssl() {
  case "${1:-}" in true|1|t|yes) ;; *) return 1 ;; esac
  [[ ! "${2:-}" =~ \.(example|local|test)$ ]]
}

cert_live() {
  [ -s "/etc/letsencrypt/live/${1}/fullchain.pem" ] && [ -s "/etc/letsencrypt/live/${1}/privkey.pem" ]
}

truthy() {
  case "${1:-}" in true|1|t|yes) return 0 ;; *) return 1 ;; esac
}

ensure_user() {
  user="$1"
  home="$2"
  ok_user "$user" || die "bad user $user"
  if [ "$DRY" -eq 1 ]; then
    return
  fi
  if ! id -u "$user" >/dev/null 2>&1; then
    useradd --home "$home" --create-home --shell "$(nologin_shell)" "$user"
  fi
}

# --- sites (PHP) -----------------------------------------------------------
SSL_DOMAINS=()

apply_sites() {
  SSL_DOMAINS=()
  mkdir -p /etc/nginx/schela.d
  if [ "$DRY" -eq 0 ]; then
    find /etc/nginx/schela.d -name 'site-*.conf' -delete 2>/dev/null || true
    find /etc/php -path '*/fpm/pool.d/schela-*.conf' -delete 2>/dev/null || true
  fi

  while IFS= read -r site; do
    [ -n "$site" ] || continue
    domain="$(jq -r '.domain' <<<"$site")"
    user="$(jq -r '.systemUser' <<<"$site")"
    pool="$(jq -r '.pool' <<<"$site")"
    php="$(jq -r '.phpVersion' <<<"$site")"
    mem="$(jq -r '.memoryLimit' <<<"$site")"
    root="$(jq -r '.root' <<<"$site")"
    status="$(jq -r '.status' <<<"$site")"
    isolated="$(jq -r '.isolated' <<<"$site")"
    ssl="$(jq -r '.ssl' <<<"$site")"
    force="$(jq -r '.forceHttps // false' <<<"$site")"
    ip="$(jq -r '.ip // empty' <<<"$site")"
    ok_ipv4 "$ip" || ip=""
    http_bind="$(bind_http "$ip")"
    https_bind="$(bind_https "$ip")"

    [ "$status" = "active" ] || continue
    ok_domain "$domain" || { log "skip site, bad domain"; continue; }
    ok_user "$user" || { log "skip $domain, bad user"; continue; }
    ok_php "$php" || { log "skip $domain, bad php $php"; continue; }
    [[ "$pool" =~ ^[A-Za-z0-9._-]+$ ]] || { log "skip $domain, bad pool"; continue; }
    [[ "$mem" =~ ^[0-9]{2,4}M$ ]] || mem="256M"
    if [[ ! "$root" =~ ^/home/${user}/www(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}){0,4}$ ]]; then
      [ "$root" = "null" ] || log "site $domain: document root outside www, using www"
      root="/home/${user}/www"
    fi

    log "site $domain  php $php  user $user"

    ensure_user "$user" "/home/$user"
    if [ "$DRY" -eq 0 ]; then
      ensure_home "$user" || continue
      # Repairs ownership of anything root created here before; chown -R
      # changes links themselves and does not follow them.
      chown -R "$user:$user" "/home/$user"
      as_user "$user" mkdir -p "/home/$user/www" "/home/$user/tmp" "/home/$user/logs" \
        || log "site $domain: could not create www, tmp or logs"
      as_user "$user" chmod 750 "/home/$user/www" || log "site $domain: could not set the mode of www"
      # nginx (www-data) must traverse the jail to serve static files / try_files.
      usermod -aG "$user" www-data 2>/dev/null || true
      printf '<?php echo htmlspecialchars(%s, ENT_QUOTES, "UTF-8");\n' "'${domain}'" \
        | as_user "$user" sh -c '[ -e "$1" ] || cat >"$1"' sh "/home/$user/www/index.php" \
        || log "site $domain: could not write the placeholder index.php"
    fi

    socket="/run/php/${pool}.sock"
    conf="$(render "$TEMPLATES/php-fpm-pool.conf" \
      __POOL__ "$pool" __USER__ "$user" __MEMORY__ "$mem")"
    if [ "$isolated" != "true" ] && [ "$isolated" != "t" ] && [ "$isolated" != "1" ]; then
      conf="$(printf '%s\n' "$conf" | grep -v open_basedir | grep -v disable_functions)"
    fi
    mkdir -p "/etc/php/${php}/fpm/pool.d"
    write_file "/etc/php/${php}/fpm/pool.d/schela-${pool}.conf" "$conf"

    if wants_ssl "$ssl" "$domain" && cert_live "$domain" && truthy "$force"; then
      vhost="$(render "$TEMPLATES/nginx-site-force.conf" \
        __DOMAIN__ "$domain" __BIND_80__ "$http_bind")"
    else
      vhost="$(render "$TEMPLATES/nginx-site.conf" \
        __DOMAIN__ "$domain" __ROOT__ "$root" __SOCKET__ "$socket" __BIND_80__ "$http_bind")"
    fi
    write_file "/etc/nginx/schela.d/site-${domain}.conf" "$vhost"
    if wants_ssl "$ssl" "$domain" && cert_live "$domain"; then
      sslv="$(render "$TEMPLATES/nginx-site-ssl.conf" \
        __DOMAIN__ "$domain" __ROOT__ "$root" __SOCKET__ "$socket" __BIND_443__ "$https_bind")"
      write_file "/etc/nginx/schela.d/site-${domain}-ssl.conf" "$sslv"
    else
      rm -f "/etc/nginx/schela.d/site-${domain}-ssl.conf"
    fi

    if wants_ssl "$ssl" "$domain"; then
      SSL_DOMAINS+=("$domain")
    fi
  done < <(jq -c '.sites // [] | .[]' "$STATE")

  if [ "$DRY" -eq 0 ]; then
    for ver in "${PHP_KNOWN[@]}"; do
      if [ -d "/etc/php/${ver}/fpm" ]; then
        systemctl enable --now "php${ver}-fpm" >/dev/null 2>&1 || true
        systemctl reload "php${ver}-fpm" >/dev/null 2>&1 || systemctl restart "php${ver}-fpm" || true
      fi
    done
  fi
}

# --- node apps -------------------------------------------------------------
# Where unit files go. Tests point this at a scratch directory.
SYSTEMD_DIR="${SCHELA_SYSTEMD_DIR:-/etc/systemd/system}"

apply_apps() {
  mkdir -p /etc/nginx/schela-apps.d /var/lib/schela/apps
  if [ "$DRY" -eq 0 ]; then
    find /etc/nginx/schela-apps.d -name 'app-*.conf' -delete 2>/dev/null || true
  fi
  # Units of every app still in the panel, valid or not; anything else is a
  # deleted app and gets stopped and removed below.
  declare -A keep_units=()

  while IFS= read -r app; do
    [ -n "$app" ] || continue
    name="$(jq -r '.name' <<<"$app")"
    domain="$(jq -r '.domain' <<<"$app")"
    ver="$(jq -r '.nodeVersion' <<<"$app")"
    port="$(jq -r '.port' <<<"$app")"
    entry="$(jq -r '.entry' <<<"$app")"
    status="$(jq -r '.status' <<<"$app")"
    ip="$(jq -r '.ip // empty' <<<"$app")"
    ok_ipv4 "$ip" || ip=""
    http_bind="$(bind_http "$ip")"
    https_bind="$(bind_https "$ip")"
    slug="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')"
    unit="schela-app-${slug}"
    user="sa_${slug:0:20}"
    keep_units["$unit"]=1

    ok_domain "$domain" || { log "skip app, bad domain"; continue; }
    ok_node "$ver" || { log "skip $name, bad node $ver"; continue; }
    ok_port "$port" || { log "skip $name, bad port"; continue; }
    ok_user "$user" || { log "skip $name, bad user"; continue; }
    [[ "$entry" =~ ^[A-Za-z0-9._/-]+$ ]] || entry="index.js"
    [[ "$entry" != *".."* ]] || entry="index.js"

    log "app $name  node $ver  :$port"

    ensure_user "$user" "/home/$user"
    if [ "$DRY" -eq 0 ]; then
      ensure_home "$user" || continue
      chown -R "$user:$user" "/home/$user"
      as_user "$user" mkdir -p "/home/$user/app" || log "app $name: could not create app"
      printf 'PORT=%s\nNODE_VERSION=%s\n' "$port" "$ver" >"/var/lib/schela/apps/${user}.env"

      NODE_BIN="/usr/local/bin/node"
      if [ -d /usr/local/n/versions/node ]; then
        found="$(ls -d /usr/local/n/versions/node/"${ver}"* 2>/dev/null | sort -V | tail -1 || true)"
        if [ -n "$found" ] && [ -x "${found}/bin/node" ]; then
          NODE_BIN="${found}/bin/node"
        fi
      fi

      unit_file="$SYSTEMD_DIR/${unit}.service"
      # The name is free text from the panel: a newline would add unit lines
      # (ExecStartPre=+ runs as root) and % is a systemd specifier.
      label="${name//[^A-Za-z0-9 ._-]/_}"
      content="$(cat <<UNIT
[Unit]
Description=Schela Node app ${label}
After=network.target
[Service]
Type=simple
User=${user}
Group=${user}
WorkingDirectory=/home/${user}/app
Environment=NODE_ENV=production
Environment=PORT=${port}
ExecStart=${NODE_BIN} /home/${user}/app/${entry}
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/${user}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# AF_NETLINK on top of the workers' set: Node's os.networkInterfaces() reads
# the interface list over netlink and throws without it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
[Install]
WantedBy=multi-user.target
UNIT
)"
      changed=0
      if [ ! -f "$unit_file" ] || [ "$(cat "$unit_file")" != "$content" ]; then
        write_file "$unit_file" "$content"
        changed=1
      fi
      systemctl daemon-reload
      if [ "$status" = "running" ]; then
        # A running app keeps its old unit until it restarts; restart it so a
        # changed unit (for example new sandboxing) takes effect now.
        if [ "$changed" -eq 1 ] && systemctl is-active --quiet "$unit"; then
          systemctl restart "$unit" || true
        fi
        systemctl enable --now "$unit" || true
      else
        systemctl disable --now "$unit" >/dev/null 2>&1 || true
      fi
    fi

    vhost="$(render "$TEMPLATES/nginx-node.conf" \
      __DOMAIN__ "$domain" __PORT__ "$port" __BIND_80__ "$http_bind")"
    write_file "/etc/nginx/schela-apps.d/app-${domain}.conf" "$vhost"
    if [[ ! "$domain" =~ \.(example|local|test)$ ]]; then
      if cert_live "$domain"; then
        sslv="$(render "$TEMPLATES/nginx-node-ssl.conf" \
          __DOMAIN__ "$domain" __PORT__ "$port" __BIND_443__ "$https_bind")"
        write_file "/etc/nginx/schela-apps.d/app-${domain}-ssl.conf" "$sslv"
      else
        rm -f "/etc/nginx/schela-apps.d/app-${domain}-ssl.conf"
      fi
      SSL_DOMAINS+=("$domain")
    fi
  done < <(jq -c '.apps // [] | .[]' "$STATE")

  [ "$DRY" -eq 0 ] || return 0
  local unit_file stale removed=0
  for unit_file in "$SYSTEMD_DIR"/schela-app-*.service; do
    [ -f "$unit_file" ] || continue
    stale="$(basename "$unit_file" .service)"
    [[ "$stale" =~ ^schela-app-[a-z0-9-]+$ ]] || continue
    [ -n "${keep_units[$stale]:-}" ] && continue
    log "removing unit of deleted app: $stale"
    systemctl disable --now "$stale" >/dev/null 2>&1 || true
    rm -f "$unit_file"
    removed=1
  done
  if [ "$removed" -eq 1 ]; then
    systemctl daemon-reload
  fi
}

# --- fail2ban ----------------------------------------------------------------
F2B_JAIL="/etc/fail2ban/jail.d/schela.conf"
F2B_FILTER="/etc/fail2ban/filter.d/schela-panel.conf"
# One action for every jail. Its bans sit in fail2ban's own nftables table
# (inet f2b-table, hooked before the filter chains), which no ufw command
# touches: ufw reset, reload, enable and rule changes leave them in place. The
# ufw action would store bans as ufw rules, which ufw rule convergence deletes.
F2B_BANACTION="nftables[type=multiport]"

# Ports sshd answers on. Schela does not configure sshd, so besides the panel
# setting take whatever sshd, or the systemd socket that starts it, listens
# on right now.
f2b_ssh_ports() {
  local s p
  {
    jq -r '.settings.sshPort // empty' "$STATE"
    if command -v ss >/dev/null 2>&1; then
      ss -Hltnp 2>/dev/null | awk '/users:\(\("sshd",/ {print $4}' | sed 's/.*://'
    fi
    for s in ssh.socket sshd.socket; do
      systemctl is-active --quiet "$s" 2>/dev/null || continue
      systemctl show -p Listen --value "$s" 2>/dev/null | tr ' ' '\n' | sed -n 's/.*:\([0-9][0-9]*\)$/\1/p'
    done
  } | while IFS= read -r p; do
    if ok_port "$p"; then echo "$p"; fi
  done | sort -n -u | paste -sd, -
}

apply_fail2ban() {
  command -v fail2ban-client >/dev/null 2>&1 || return 0
  [ -d "${F2B_JAIL%/*}" ] && [ -d "${F2B_FILTER%/*}" ] || return 0
  local ports jail filter old_jail="" old_filter="" had_jail=0 had_filter=0
  ports="$(f2b_ssh_ports)"
  [ -n "$ports" ] || ports="ssh"

  # backend = systemd everywhere: Debian 12 and 13 have no /var/log/auth.log
  # or mail.log by default, and on every supported system sshd, Postfix,
  # Dovecot and the panel all log to the journal. Ban time, find time and
  # retries are fail2ban's defaults from jail.conf.
  jail="# Managed by schela-apply: rewritten on every apply. Put local changes in
# /etc/fail2ban/jail.local, which fail2ban reads after this file.

[sshd]
enabled = true
port = ${ports}
backend = systemd
# Ubuntu names the unit ssh.service; OpenSSH 9.8 and later log failed logins
# from sshd-session.
journalmatch = _SYSTEMD_UNIT=ssh.service + _SYSTEMD_UNIT=sshd.service + _COMM=sshd + _COMM=sshd-session
banaction = ${F2B_BANACTION}

[schela-panel]
enabled = true
filter = schela-panel
port = http,https
backend = systemd
banaction = ${F2B_BANACTION}"
  if mod_on mail; then
    jail+="

[postfix]
enabled = true
# Rejections, SASL failures and dropped connections.
mode = aggressive
backend = systemd
# Postfix on Ubuntu 22.04/24.04 and Debian 12 runs as postfix@-.service, which
# the stock filter on those releases does not match.
journalmatch = _SYSTEMD_UNIT=postfix.service + _SYSTEMD_UNIT=postfix@-.service
banaction = ${F2B_BANACTION}

[dovecot]
enabled = true
backend = systemd
banaction = ${F2B_BANACTION}"
  fi

  filter="# Managed by schela-apply. Failed panel sign-ins, which the panel prints to
# stdout and systemd stores in the journal of schela-panel.service.

[INCLUDES]
before = common.conf

[Definition]
# <ADDR> takes an IP address only, never a host name to resolve.
failregex = ^%(__prefix_line)sschela-auth: failed sign-in from <ADDR>\$
ignoreregex =

[Init]
journalmatch = _SYSTEMD_UNIT=schela-panel.service"

  if [ -f "$F2B_JAIL" ]; then had_jail=1; old_jail="$(cat "$F2B_JAIL")"; fi
  if [ -f "$F2B_FILTER" ]; then had_filter=1; old_filter="$(cat "$F2B_FILTER")"; fi
  if [ "$had_jail" -eq 1 ] && [ "$old_jail" = "$jail" ] \
    && [ "$had_filter" -eq 1 ] && [ "$old_filter" = "$filter" ]; then
    return 0
  fi
  write_file "$F2B_FILTER" "$filter"
  write_file "$F2B_JAIL" "$jail"
  [ "$DRY" -eq 0 ] || return 0

  if ! fail2ban-client -t >/dev/null 2>&1; then
    # Never leave fail2ban with a configuration it refuses to load.
    if [ "$had_jail" -eq 1 ]; then write_file "$F2B_JAIL" "$old_jail"; else rm -f "$F2B_JAIL"; fi
    if [ "$had_filter" -eq 1 ]; then write_file "$F2B_FILTER" "$old_filter"; else rm -f "$F2B_FILTER"; fi
    log "fail2ban: configuration test failed, kept the previous jails"
    return 0
  fi
  log "fail2ban: jails sshd (port ${ports}), schela-panel$(mod_on mail && printf ', postfix, dovecot')"
  systemctl reload-or-restart fail2ban || log "fail2ban: reload failed"
}

# --- site workers (queues, Horizon, scheduler) ------------------------------
# argv must be 1-32 non-empty strings without control characters.
WORKER_ARGV_OK='(.argv | type == "array") and (.argv | length >= 1 and length <= 32) and (.argv | all(type == "string" and length >= 1 and length <= 200 and (test("[[:cntrl:]]") | not)))'
# Quote one ExecStart= argument: inside double quotes systemd unescapes \\ and
# \", and expands %specifiers and $VARIABLES, so escape all four.
WORKER_SD='def sd: "\"" + (gsub("\\\\"; "\\\\") | gsub("\""; "\\\"") | gsub("%"; "%%") | gsub("\\$"; "$$")) + "\"";'

worker_instances() {
  # Every instance systemd knows about or will start at boot, for one worker id.
  {
    systemctl list-units --all --plain --no-legend --type=service "schela-worker-${1}@*.service" 2>/dev/null \
      | awk '{print $1}'
    for link in "$SYSTEMD_DIR"/multi-user.target.wants/schela-worker-"${1}"@*.service; do
      [ -e "$link" ] || [ -L "$link" ] || continue
      basename "$link"
    done
  } | grep -E "^schela-worker-${1}@[0-9]+\.service$" | sort -u
}

worker_stop() {
  # Disable and stop without waiting: a queue job may take minutes to finish.
  systemctl disable --now --no-block "$1" >/dev/null 2>&1 || true
}

apply_workers() {
  declare -A w_procs=() w_enabled=() w_changed=()
  local reload=0

  while IFS= read -r worker; do
    [ -n "$worker" ] || continue
    id="$(jq -r '.id' <<<"$worker")"
    [[ "$id" =~ ^[1-9][0-9]{0,8}$ ]] || { log "skip worker, bad id"; continue; }
    user="$(jq -r '.user' <<<"$worker")"
    php="$(jq -r '.phpVersion' <<<"$worker")"
    domain="$(jq -r '.domain' <<<"$worker")"
    name="$(jq -r '.name' <<<"$worker")"
    procs="$(jq -r '.processes' <<<"$worker")"
    stop="$(jq -r '.stopTimeout' <<<"$worker")"
    mem="$(jq -r '.memoryMb' <<<"$worker")"
    enabled="$(jq -r '.enabled' <<<"$worker")"

    ok_user "$user" || { log "skip worker $id, bad user"; continue; }
    ok_php "$php" || { log "skip worker $id, bad php"; continue; }
    ok_domain "$domain" || { log "skip worker $id, bad domain"; continue; }
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]{0,59}$ ]] || { log "skip worker $id, bad name"; continue; }
    [[ "$procs" =~ ^[1-8]$ ]] || { log "skip worker $id, bad process count"; continue; }
    [[ "$stop" =~ ^[0-9]{1,4}$ ]] && [ "$stop" -ge 5 ] && [ "$stop" -le 7200 ] \
      || { log "skip worker $id, bad stop timeout"; continue; }
    [[ "$mem" =~ ^[0-9]{2,4}$ ]] && [ "$mem" -ge 64 ] && [ "$mem" -le 8192 ] \
      || { log "skip worker $id, bad memory limit"; continue; }
    jq -e "$WORKER_ARGV_OK" <<<"$worker" >/dev/null || { log "skip worker $id, bad command"; continue; }

    exe="$(jq -r '.argv[0]' <<<"$worker")"
    if [ "$exe" = "php" ]; then
      exe="/usr/bin/php${php}"
    elif [[ "$exe" =~ ^/[A-Za-z0-9._/-]+$ ]] && [[ "$exe/" != */../* ]]; then
      :
    elif [[ "$exe" =~ ^[A-Za-z0-9._-][A-Za-z0-9._/-]*$ ]] && [[ "/$exe/" != */../* ]] && [[ "$exe" != */ ]]; then
      exe="/home/${user}/www/${exe}"
    else
      log "skip worker $id, bad executable"
      continue
    fi
    if [ "$DRY" -eq 0 ]; then
      uid="$(id -u "$user" 2>/dev/null || true)"
      # useradd gives site users UID_MIN..UID_MAX (1000-59999); never root,
      # system accounts, or nobody (65534).
      if [[ ! "$uid" =~ ^[0-9]+$ ]] || [ "$uid" -lt 1000 ] || [ "$uid" -ge 60000 ]; then
        log "skip worker $id, $user is not a site user"
        continue
      fi
    fi
    execline="$(jq -r --arg exe "$exe" "$WORKER_SD"' ([$exe] + .argv[1:]) | map(sd) | join(" ")' <<<"$worker")"

    content="[Unit]
Description=Schela worker ${name} for ${domain} (process %i)
After=network-online.target mysql.service mariadb.service postgresql.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=${user}
Group=${user}
WorkingDirectory=/home/${user}/www
Environment=HOME=/home/${user}
ExecStart=${execline}
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=${stop}
MemoryMax=${mem}M
TasksMax=256
UMask=0022
SyslogIdentifier=schela-worker-${id}
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/${user}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target"

    unit_file="$SYSTEMD_DIR/schela-worker-${id}@.service"
    changed=0
    if [ ! -f "$unit_file" ] || [ "$(cat "$unit_file")" != "$content" ]; then
      write_file "$unit_file" "$content"
      changed=1
      reload=1
    fi
    w_procs[$id]="$procs"
    w_enabled[$id]=0
    truthy "$enabled" && w_enabled[$id]=1
    w_changed[$id]="$changed"
    log "worker $id ($name) on $domain: ${procs} process(es), $([ "${w_enabled[$id]}" -eq 1 ] && echo on || echo off)"
  done < <(jq -c '.workers // [] | .[]' "$STATE")

  # Workers removed from the panel (or whose site is gone).
  for unit_file in "$SYSTEMD_DIR"/schela-worker-*@.service; do
    [ -e "$unit_file" ] || continue
    wid="${unit_file##*/schela-worker-}"
    wid="${wid%@.service}"
    [[ "$wid" =~ ^[0-9]+$ ]] || continue
    [ -n "${w_procs[$wid]+x}" ] && continue
    if [ "$DRY" -eq 1 ]; then
      log "would remove worker $wid"
      continue
    fi
    log "remove worker $wid"
    while IFS= read -r inst; do
      [ -n "$inst" ] && worker_stop "$inst"
    done < <(worker_instances "$wid")
    rm -f "$unit_file" "$SYSTEMD_DIR"/multi-user.target.wants/schela-worker-"${wid}"@*.service
    reload=1
  done

  [ "$DRY" -eq 1 ] && return
  [ "$reload" -eq 1 ] && systemctl daemon-reload

  for id in "${!w_procs[@]}"; do
    procs="${w_procs[$id]}"
    if [ "${w_enabled[$id]}" -eq 1 ]; then
      for n in $(seq 1 "$procs"); do
        inst="schela-worker-${id}@${n}.service"
        if systemctl is-active --quiet "$inst"; then
          # Picks up a changed unit; SIGTERM lets the current job finish.
          [ "${w_changed[$id]}" -eq 1 ] && systemctl restart --no-block "$inst"
        else
          systemctl reset-failed "$inst" >/dev/null 2>&1 || true
        fi
        systemctl enable --now --no-block "$inst" >/dev/null 2>&1 || log "worker $id: could not start $inst"
      done
    fi
    while IFS= read -r inst; do
      [ -n "$inst" ] || continue
      n="${inst#schela-worker-${id}@}"
      n="${n%.service}"
      if [ "${w_enabled[$id]}" -eq 0 ] || [ "$n" -gt "$procs" ]; then
        worker_stop "$inst"
      fi
    done < <(worker_instances "$id")
  done
}

# --- firewall --------------------------------------------------------------
# apply_firewall owns the whole ufw ruleset and converges it on every run: SSH,
# 80/tcp, 443/tcp, the ports of enabled modules and the panel's enabled rules.
# Every other rule is removed. ufw is first-match, so deny rules sit above all
# allow rules. Missing rules are added before stale ones are deleted and ufw is
# never reset or disabled, so SSH stays allowed at every step.
# The panel lists the same base rules: src/features/firewall/base.ts.
ufwc() { LC_ALL=C ufw "$@"; }

# Ports sshd uses: the panel setting plus every port sshd is configured for or
# listening on. Schela never reconfigures sshd; a wrong setting must not close
# the port the admin logs in on.
ssh_ports() {
  local setting
  setting="$(jq -r '.settings.sshPort // 22' "$STATE")"
  ok_port "$setting" || setting=22
  {
    echo "$setting"
    if command -v sshd >/dev/null 2>&1; then
      # sshd -T refuses to run without its privilege separation directory,
      # which only exists once the ssh service has started.
      [ -d /run/sshd ] || [ "$DRY" -eq 1 ] || install -d -m 0755 /run/sshd
      sshd -T 2>/dev/null | awk '
        $1 == "port" { print $2 }
        $1 == "listenaddress" { n = split($2, a, ":"); print a[n] }' || true
    fi
    if command -v ss >/dev/null 2>&1; then
      ss -Hltnp 2>/dev/null | awk '/\("sshd",/ { n = split($4, a, ":"); print a[n] }' || true
    fi
  } | while read -r p; do if ok_port "$p"; then echo "$p"; fi; done | sort -un
}

# The wanted ruleset, one rule per line in the form `ufw show added` prints it:
# deny rules first, then allow rules. Arguments: the SSH ports.
firewall_wanted() {
  python3 - "$STATE" "$@" <<'PY'
import ipaddress, json, sys

state = json.load(open(sys.argv[1]))
ssh = {int(p) for p in sys.argv[2:]}
modules = state.get("modules") or {}

def warn(msg):
    print(f"schela-apply: firewall: {msg}", file=sys.stderr)

def port_of(value):
    s = str(value)
    if not s.isdigit() or not 1 <= int(s) <= 65535:
        return None
    return int(s)

def source_of(value):
    s = str(value).strip()
    if s == "any":
        return "any"
    if "%" in s:  # ufw takes no IPv6 zone index
        return None
    try:
        net = ipaddress.ip_network(s, strict=False)
    except ValueError:
        return None
    # ufw reads a /0 as "any" (both families), keeps the network address of
    # a range and drops a host prefix.
    if net.prefixlen == 0:
        return "any"
    if net.prefixlen == net.max_prefixlen:
        return str(net.network_address)
    return str(net)

def match(port, proto, source):
    if source == "any":
        return str(port) if proto == "any" else f"{port}/{proto}"
    tail = f" proto {proto}" if proto != "any" else ""
    return f"from {source} to any port {port}{tail}"

base = [(p, "tcp") for p in sorted(ssh)] + [(80, "tcp"), (443, "tcp")]
if modules.get("mail") is True:
    base += [(25, "tcp"), (587, "tcp"), (993, "tcp")]
if modules.get("dns") is True:
    base += [(53, "tcp"), (53, "udp")]

denies, allows = [], [("allow", match(p, proto, "any")) for p, proto in base]
for rule in state.get("firewall") or []:
    if rule.get("enabled") is not True:
        continue
    action = rule.get("action")
    proto = rule.get("protocol")
    port = port_of(rule.get("port"))
    source = source_of(rule.get("source", "any"))
    if action not in ("allow", "deny") or proto not in ("tcp", "udp", "any") or port is None or source is None:
        warn(f"skipped invalid rule {json.dumps(rule)}")
        continue
    if action == "deny" and source == "any" and port in ssh and proto in ("tcp", "any"):
        warn(f"kept SSH open: skipped deny {proto}/{port} from {source}")
        continue
    (denies if action == "deny" else allows).append((action, match(port, proto, source)))

# ufw holds one rule per match and changes its action in place, so a deny and
# an allow on the same match cannot both exist: the deny wins.
seen = set()
for action, m in denies + allows:
    if m in seen:
        continue
    seen.add(m)
    print(f"{action} {m}")
PY
}

# Rules ufw holds now, in the same form. Comments are dropped: ufw matches
# rules without them.
firewall_current() {
  ufwc show added | sed -n "s/^ufw //p" | sed -E "s/ comment '.*'\$//"
}

# ufw is first-match: no deny rule may sit below a rule with another action,
# in the IPv4 or the IPv6 table.
firewall_deny_first() {
  local f
  for f in /etc/ufw/user.rules /etc/ufw/user6.rules; do
    [ -f "$f" ] || continue
    awk '$1 == "###" && $2 == "tuple" { if ($4 == "deny") { if (other) bad = 1 } else other = 1 }
      END { exit bad }' "$f" || return 1
  done
}

# $1: a rule as firewall_current prints it.
firewall_delete() {
  local args
  case "$1" in
    route\ *) read -ra args <<<"${1#route }"; ufwc --force route delete "${args[@]}" >/dev/null ;;
    *) read -ra args <<<"$1"; ufwc --force delete "${args[@]}" >/dev/null ;;
  esac
}

apply_firewall() {
  if ! command -v ufw >/dev/null 2>&1; then
    log "ufw not installed: firewall not applied"
    return 0
  fi
  local ssh want have r args out
  out="$(ssh_ports)"
  mapfile -t ssh <<<"$out"
  # Never converge towards a ruleset that could not be computed: an empty one
  # would delete SSH.
  out="$(firewall_wanted "${ssh[@]}")" || die "firewall: could not compute the ruleset"
  mapfile -t want <<<"$out"
  [ -n "$out" ] && [ "${#ssh[@]}" -gt 0 ] && [ -n "${ssh[0]}" ] || die "firewall: empty ruleset"
  if [ "$DRY" -eq 1 ]; then
    log "would converge ufw to ${#want[@]} rules (ssh ports: ${ssh[*]})"
    for r in "${want[@]}"; do log "  ufw $r"; done
    return
  fi
  local -A wanted=() held=() held_match=()
  for r in "${want[@]}"; do wanted["$r"]=1; done
  mapfile -t have < <(firewall_current)
  for r in "${have[@]}"; do held["$r"]=1; held_match["${r#* }"]="$r"; done

  # 1. Allow rules first, SSH included: nothing is removed before they hold.
  # ufw appends a new rule, or changes the action of a rule with the same
  # match in place (a legacy `limit 22/tcp` becomes `allow 22/tcp` with no gap).
  for r in "${want[@]}"; do
    [ "${r%% *}" = "allow" ] && [ -z "${held[$r]:-}" ] || continue
    read -ra args <<<"$r"
    ufwc "${args[@]}" >/dev/null
  done
  # 2. New deny rules go on top. ufw skips a prepend when a rule with the same
  # match exists, so that rule goes first: the traffic is dropped by the
  # default policy until the deny is in.
  for r in "${want[@]}"; do
    [ "${r%% *}" = "deny" ] && [ -z "${held[$r]:-}" ] || continue
    [ -z "${held_match[${r#* }]:-}" ] || firewall_delete "${held_match[${r#* }]}"
    read -ra args <<<"$r"
    ufwc prepend "${args[@]}" >/dev/null
  done
  # 3. Everything else goes: rules removed or turned off in the panel, ports
  # of modules turned off, rules left by older installs or added by hand.
  mapfile -t have < <(firewall_current)
  for r in "${have[@]}"; do
    [ -n "${wanted[$r]:-}" ] || firewall_delete "$r"
  done
  # 4. An allow that replaced an old deny in place (step 1) sits above the
  # denies: move the denies back up.
  if ! firewall_deny_first; then
    for r in "${want[@]}"; do
      [ "${r%% *}" = "deny" ] || continue
      firewall_delete "$r"
      read -ra args <<<"$r"
      ufwc prepend "${args[@]}" >/dev/null
    done
  fi

  grep -qx 'DEFAULT_INPUT_POLICY="DROP"' /etc/default/ufw || ufwc default deny incoming >/dev/null
  grep -qx 'DEFAULT_OUTPUT_POLICY="ACCEPT"' /etc/default/ufw || ufwc default allow outgoing >/dev/null
  # grep without -q reads all of ufw's output: no SIGPIPE under pipefail.
  ufwc status | grep -x 'Status: active' >/dev/null || ufwc --force enable >/dev/null

  mapfile -t have < <(firewall_current)
  if [ "$(printf '%s\n' "${have[@]}" | sort)" != "$(printf '%s\n' "${want[@]}" | sort)" ] \
    || ! firewall_deny_first; then
    die "firewall did not converge: ufw holds [$(printf '%s; ' "${have[@]}")], wanted [$(printf '%s; ' "${want[@]}")]"
  fi
  log "firewall: ${#want[@]} rules (ssh ports: ${ssh[*]})"
}

# --- automatic updates -----------------------------------------------------
# settings.autoUpdates turns the daily package list refresh and
# unattended-upgrades on or off. Which updates it installs stays the
# distribution's default (50unattended-upgrades). install.sh writes the same
# file before the first apply.
apply_auto_updates() {
  local v=1
  [ "$(jq -r '.settings.autoUpdates' "$STATE")" = "false" ] && v=0
  write_file /etc/apt/apt.conf.d/20auto-upgrades "// Managed by Schela: the panel setting \"Unattended upgrades\".
APT::Periodic::Update-Package-Lists \"$v\";
APT::Periodic::Unattended-Upgrade \"$v\";"
}

# --- mail ------------------------------------------------------------------
# Server hostname certificate, maintained outside apply_mail (Let's Encrypt or
# self-signed). Dovecot and Postfix read it as root before dropping privileges.
MAIL_TLS_CERT="/var/lib/schela/tls/host.crt"
MAIL_TLS_KEY="/var/lib/schela/tls/host.key"

# Postfix submission on 587: TLS before AUTH, SASL through Dovecot, relay only
# for authenticated users, and only as an address the login owns.
mail_submission() {
  postconf -M submission/inet="submission inet n - n - - smtpd"
  local opt
  for opt in \
    syslog_name=postfix/submission \
    smtpd_tls_security_level=encrypt \
    smtpd_tls_auth_only=yes \
    smtpd_sasl_auth_enable=yes \
    smtpd_sasl_type=dovecot \
    smtpd_sasl_path=private/auth \
    smtpd_sasl_security_options=noanonymous \
    smtpd_sender_login_maps=hash:/var/lib/schela/mail/senders \
    smtpd_client_restrictions=permit_sasl_authenticated,reject \
    smtpd_sender_restrictions=reject_sender_login_mismatch \
    smtpd_relay_restrictions=permit_sasl_authenticated,reject; do
    postconf -P "submission/inet/${opt}"
  done
}

apply_mail() {
  mod_on mail || return 0
  [ -d /etc/postfix ] || return 0
  [ "$DRY" -eq 1 ] && { log "would apply mail maps"; return; }
  # Root writes the maps; postfix reads them. Reset owner and mode on every run
  # so an install that handed the folder to the panel user heals itself.
  install -d -m 0755 -o root -g root /var/lib/schela/mail
  mkdir -p /var/mail/schela
  if ! id -u vmail >/dev/null 2>&1; then
    useradd --system --home /var/mail/schela --shell "$(nologin_shell)" vmail
  fi
  vuid="$(id -u vmail)"
  vgid="$(id -g vmail)"
  dove_ver="$(dovecot --version 2>/dev/null | awk '{print $1}' || true)"
  case "$dove_ver" in
    2.[4-9]*|[3-9]*) dove24=1 ;;
    *) dove24=0 ;;
  esac
  : >/var/lib/schela/mail/vmailbox
  : >/var/lib/schela/mail/vdomains
  : >/var/lib/schela/mail/users
  : >/var/lib/schela/mail/senders
  while IFS= read -r box; do
    [ -n "$box" ] || continue
    addr="$(jq -r '.address' <<<"$box")"
    status="$(jq -r '.status' <<<"$box")"
    hash="$(jq -r '.passwordHash // empty' <<<"$box")"
    quota="$(jq -r '.quotaMb // 2048' <<<"$box")"
    [ "$status" = "active" ] || continue
    [[ "$addr" =~ ^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+$ ]] || continue
    [[ "$quota" =~ ^[0-9]+$ ]] || quota=2048
    domain="${addr#*@}"
    localpart="${addr%@*}"
    printf '%s %s/\n' "$addr" "$domain/$localpart" >>/var/lib/schela/mail/vmailbox
    # Each mailbox login owns exactly its own address on submission.
    printf '%s %s\n' "$addr" "$addr" >>/var/lib/schela/mail/senders
    grep -qxF "$domain" /var/lib/schela/mail/vdomains 2>/dev/null || echo "$domain" >>/var/lib/schela/mail/vdomains
    mkdir -p "/var/mail/schela/${domain}/${localpart}/cur" \
             "/var/mail/schela/${domain}/${localpart}/new" \
             "/var/mail/schela/${domain}/${localpart}/tmp"
    if [[ "$hash" == \{SSHA512\}* ]]; then
      # Numeric uid/gid. A name here is dropped when NSS lookup fails at parse time,
      # and then IMAP never sees the mailbox.
      if [ "$dove24" -eq 1 ]; then
        extra="userdb_quota_storage_size=${quota}M"
      else
        extra="userdb_quota_rule=*:storage=${quota}M"
      fi
      printf '%s:%s:%s:%s::/var/mail/schela/%s/%s::%s\n' \
        "$addr" "$hash" "$vuid" "$vgid" "$domain" "$localpart" "$extra" \
        >>/var/lib/schela/mail/users
    fi
    mkdir -p /var/lib/schela/dkim
    if [ ! -f "/var/lib/schela/dkim/${domain}.private" ] && command -v opendkim-genkey >/dev/null 2>&1; then
      opendkim-genkey -D /var/lib/schela/dkim -s mail -d "$domain" >/dev/null 2>&1 || true
      if [ -f /var/lib/schela/dkim/mail.private ]; then
        mv /var/lib/schela/dkim/mail.private "/var/lib/schela/dkim/${domain}.private"
        mv /var/lib/schela/dkim/mail.txt "/var/lib/schela/dkim/${domain}.txt" 2>/dev/null || true
      fi
    fi
  done < <(jq -c '.mailboxes // [] | .[]' "$STATE")
  chown -R vmail:vmail /var/mail/schela
  postmap /var/lib/schela/mail/vmailbox 2>/dev/null || true
  postmap /var/lib/schela/mail/senders 2>/dev/null || true
  chown root:root /var/lib/schela/mail/vmailbox /var/lib/schela/mail/vmailbox.db /var/lib/schela/mail/vdomains \
    /var/lib/schela/mail/senders /var/lib/schela/mail/senders.db 2>/dev/null || true
  chmod 644 /var/lib/schela/mail/vmailbox /var/lib/schela/mail/vmailbox.db /var/lib/schela/mail/vdomains \
    /var/lib/schela/mail/senders /var/lib/schela/mail/senders.db 2>/dev/null || true
  postconf -e "virtual_mailbox_base = /var/mail/schela"
  postconf -e "virtual_mailbox_maps = hash:/var/lib/schela/mail/vmailbox"
  postconf -e "virtual_mailbox_domains = /var/lib/schela/mail/vdomains"
  postconf -e "virtual_minimum_uid = 100"
  postconf -e "virtual_uid_maps = static:${vuid}"
  postconf -e "virtual_gid_maps = static:${vgid}"
  # Port 25 offers STARTTLS but does not require it (other servers may not
  # speak TLS) and never offers AUTH: clients authenticate on 587.
  have_cert=0
  if [ -s "$MAIL_TLS_CERT" ] && [ -s "$MAIL_TLS_KEY" ]; then
    have_cert=1
    postconf -e "smtpd_tls_cert_file = ${MAIL_TLS_CERT}"
    postconf -e "smtpd_tls_key_file = ${MAIL_TLS_KEY}"
  else
    log "warning: ${MAIL_TLS_CERT} or ${MAIL_TLS_KEY} missing: mail keeps its previous TLS certificate; IMAP and submission still refuse passwords without TLS"
  fi
  postconf -e "smtpd_tls_security_level = may"
  postconf -e "smtpd_sasl_auth_enable = no"
  mail_submission
  if [ -d /etc/dovecot/conf.d ]; then
    # Without the hostname certificate Dovecot keeps the distro one.
    dove_ssl=""
    if [ "$have_cert" -eq 1 ] && [ "$dove24" -eq 1 ]; then
      dove_ssl="ssl_server_cert_file = ${MAIL_TLS_CERT}
ssl_server_key_file = ${MAIL_TLS_KEY}
"
    elif [ "$have_cert" -eq 1 ]; then
      dove_ssl="ssl_cert = <${MAIL_TLS_CERT}
ssl_key = <${MAIL_TLS_KEY}
"
    fi
    if [ "$dove24" -eq 1 ]; then
      cat >/etc/dovecot/conf.d/99-schela.conf <<DOVE
