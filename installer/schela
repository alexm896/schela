#!/bin/bash
# schela — operator CLI
set -euo pipefail
VERSION="$(cat /usr/local/share/schela/VERSION 2>/dev/null || echo 0.1.0)"

usage() {
  cat <<EOF
schela ${VERSION}
  apply [--dry-run]   write nginx, PHP-FPM, firewall, mail, DNS from panel state
  doctor              check nginx, PHP, disk, firewall
  status              panel + stack units (nginx, redis, search engines if installed)
  fix                 put the panel on port 80 (disable welcome page, reload nginx)
  reset-admin-password
                      set a new random admin password and print it once (root only)
  version
EOF
}

activate_http() {
  [ "$(id -u)" -eq 0 ] || { echo "root required" >&2; exit 1; }
  rm -f /etc/nginx/sites-enabled/default \
        /etc/nginx/sites-enabled/default.conf \
        /etc/nginx/conf.d/default.conf
  find /etc/nginx/sites-enabled -maxdepth 1 -name '*default*' -delete 2>/dev/null || true
  if [ ! -f /etc/nginx/sites-available/schela-panel.conf ]; then
    install -m 0644 /usr/local/share/schela/templates/nginx-panel.conf \
      /etc/nginx/sites-available/schela-panel.conf
  fi
  ln -sfn /etc/nginx/sites-available/schela-panel.conf /etc/nginx/sites-enabled/schela-panel.conf
  nginx -t
  systemctl restart schela-panel
  systemctl reload nginx || systemctl restart nginx
  echo "schela: panel is on port 80"
}

# The panel sets the password itself (Better Auth hashes it) when its next
# request finds admin-reset.json, then deletes the file. Nothing keeps it.
reset_admin_password() {
  [ "$(id -u)" -eq 0 ] || { echo "root required" >&2; exit 1; }
  # sudoers lets the panel user run this script; the reset is root's alone.
  [ "${SUDO_USER:-}" != schela ] || { echo "root required" >&2; exit 1; }
  local dir=/var/lib/schela port pass req i
  req="$dir/admin-reset.json"
  port="$(sed -n 's/^Environment=PORT=//p' /etc/systemd/system/schela-panel.service 2>/dev/null | head -1 || true)"
  port="${port:-9090}"
  pass="$(openssl rand -hex 8)"
  # Written as the panel user, into the panel's own directory: root never
  # writes there through a link the panel user may have planted.
  printf '{"password":"%s"}\n' "$pass" \
    | runuser -u schela -- sh -c 'umask 077 && cat >"$1.tmp" && mv -f "$1.tmp" "$1"' sh "$req" \
    || { echo "schela: could not write $req" >&2; exit 1; }
  for i in $(seq 1 30); do
    curl -sf -o /dev/null --max-time 5 "http://127.0.0.1:${port}/login" || true
    [ -e "$req" ] || break
    sleep 1
  done
  if [ -e "$req" ]; then
    rm -f "$req"
    echo "schela: the panel did not take the new password. Is schela-panel running?" >&2
    exit 1
  fi
  printf 'New admin password: %s\n' "$pass"
  printf 'Shown once and not saved anywhere.\n'
}

cmd="${1:-}"
case "$cmd" in
  apply)
    exec /usr/local/sbin/schela-apply "${2:-}"
    ;;
  version|-v|--version)
    echo "schela ${VERSION}"
    ;;
  fix)
    activate_http
    ;;
  reset-admin-password)
    reset_admin_password
    ;;
  status)
    systemctl is-active --quiet schela-panel && echo "panel: running" || echo "panel: down"
    systemctl is-active --quiet nginx && echo "nginx: running" || echo "nginx: down"
    if systemctl cat redis-server.service >/dev/null 2>&1 || systemctl cat redis.service >/dev/null 2>&1; then
      ru=redis-server
      systemctl cat redis-server.service >/dev/null 2>&1 || ru=redis
      if systemctl is-active --quiet "$ru"; then
        printf 'redis: running'
      else
        printf 'redis: stopped'
      fi
      if systemctl is-enabled --quiet "$ru" 2>/dev/null; then
        echo " (enabled at boot)"
      else
        echo " (disabled at boot — package kept)"
      fi
    fi
    for unit in meilisearch typesense; do
      [ -f "/etc/systemd/system/${unit}.service" ] || continue
      if systemctl is-active --quiet "$unit"; then
        echo "${unit}: running"
      else
        echo "${unit}: stopped"
      fi
    done
    ufw status | head -1 || true
    ;;
  doctor)
    echo "-- nginx"
    nginx -t
    if [ -e /etc/nginx/sites-enabled/default ]; then
      echo "WARN: distro default site still enabled — you will see Welcome to nginx"
    fi
    echo "-- panel"
    systemctl is-active schela-panel && echo "schela-panel: running" || echo "schela-panel: DOWN"
    curl -sf -o /dev/null -w "local_panel HTTP %{http_code}\n" "http://127.0.0.1:9090/" \
      || echo "local_panel: not answering on :9090"
    echo "-- php-fpm"
    versions="${SCHELA_VERSIONS:-/usr/local/share/schela/versions.json}"
    php_versions=""
    if [ -r "$versions" ]; then
      php_versions="$(jq -r '.php.supported[], .php.retired[]' "$versions")"
    else
      echo "  WARN: no version catalog at $versions"
    fi
    for v in $php_versions; do
      if systemctl list-unit-files "php${v}-fpm.service" >/dev/null 2>&1; then
        printf '  php%s-fpm %s\n' "$v" "$(systemctl is-active php${v}-fpm 2>/dev/null || echo missing)"
      fi
    done
    echo "-- redis"
    if command -v redis-server >/dev/null 2>&1; then
      ru=redis-server
      systemctl cat redis-server.service >/dev/null 2>&1 || ru=redis
      printf '  installed  %s\n' "$(redis-server --version 2>/dev/null | awk '{print $3}' | tr -d 'v=')"
      printf '  active     %s\n' "$(systemctl is-active "$ru" 2>/dev/null || echo unknown)"
      printf '  boot       %s\n' "$(systemctl is-enabled "$ru" 2>/dev/null || echo disabled)"
    else
      echo "  not installed (enable the Redis module in the panel)"
    fi
    for engine in meilisearch:7700 typesense:8108; do
      unit="${engine%%:*}"
      port="${engine##*:}"
      echo "-- ${unit}"
      if [ -f "/etc/systemd/system/${unit}.service" ]; then
        printf '  active     %s\n' "$(systemctl is-active "$unit" 2>/dev/null || echo unknown)"
        printf '  boot       %s\n' "$(systemctl is-enabled "$unit" 2>/dev/null || echo disabled)"
        if curl -sf -o /dev/null "http://127.0.0.1:${port}/health"; then
          echo "  health     ok on 127.0.0.1:${port}"
        else
          echo "  health     not answering on 127.0.0.1:${port}"
        fi
      else
        echo "  not installed (enable the module in the panel)"
      fi
    done
    echo "-- disk"
    df -h / /var /home 2>/dev/null | awk 'NR==1 || /\/$|\/var|\/home/'
    echo "-- firewall"
    ufw status verbose | head -20
    echo "-- state"
    [ -f /var/lib/schela/state.json ] && jq '{hostname:.settings.hostname, sites:(.sites|length), apps:(.apps|length)}' /var/lib/schela/state.json
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
